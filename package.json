{
  "name": "wormhole",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:packages",
    "build:packages": "npm run build --workspaces --if-present",
    "prebuild": "npm run build:packages",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run build:packages && tsc --noEmit"
  },
  "dependencies": {
    "@wormhole/adolfo-ronaldo": "0.1.0",
    "@wormhole/glitch-button": "0.2.0",
    "@wormhole/rickroll-launcher": "0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@wormhole/hiring-form": "0.1.0",
    "@wormhole/language-toggle": "0.1.0",
    "@wormhole/page-demolition": "0.1.0",
    "@wormhole/mouse-virus": "0.1.0",
    "@wormhole/cursed-song": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.12",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
